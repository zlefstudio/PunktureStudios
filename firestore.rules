rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Provision staff/{Firebase Auth UID} with { enabled: true } in the
    // Firebase console. Clients cannot grant themselves staff access.
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.enabled == true;
    }
    function tombstone(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'deleted', 'updatedAt', 'writerId'])
        && d.id == id && d.deleted == true && d.updatedAt is number && d.updatedAt >= 0;
    }
    function optionalString(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }
    function optionalNumber(d, key) {
      return !(key in d) || (d[key] is number && d[key] >= 0);
    }
    function appointmentInstantMatches(d) {
      let local = timestamp.value(d.requestedFor) + duration.value(8, 'h');
      let date = d.date.split('-');
      let time = d.time.split(':');
      return local.year() == int(date[0]) && local.month() == int(date[1]) && local.day() == int(date[2])
        && local.hours() == int(time[0]) && local.minutes() == int(time[1])
        && local.seconds() == 0;
    }
    function validTicket(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'writerId', 'ticketNumber', 'name', 'status', 'notes', 'createdAt', 'updatedAt', 'archivedAt', 'queueOrder', 'calledAt', 'startedAt', 'finishedAt', 'cancelledAt'])
        && d.id == id && d.ticketNumber is int && d.ticketNumber > 0
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.status in ['waiting', 'called', 'in_progress', 'finished', 'cancelled']
        && d.createdAt is number && d.createdAt >= 0 && d.updatedAt is number && d.updatedAt >= 0
        && optionalString(d, 'notes', 2000)
        && (!('queueOrder' in d) || d.queueOrder is int)
        && optionalNumber(d, 'archivedAt') && optionalNumber(d, 'calledAt')
        && optionalNumber(d, 'startedAt') && optionalNumber(d, 'finishedAt') && optionalNumber(d, 'cancelledAt');
    }
    function validItem(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'writerId', 'ticketId', 'memberLabel', 'placementName', 'basePrice', 'upgradeLabel', 'upgradePrice', 'quantity', 'createdAt', 'updatedAt'])
        && d.id == id && d.ticketId is string && d.ticketId.size() > 0 && d.ticketId.size() <= 128
        && d.placementName is string && d.placementName.size() > 0 && d.placementName.size() <= 200
        && d.upgradeLabel is string && d.upgradeLabel.size() <= 200
        && d.basePrice is number && d.basePrice >= 0 && d.upgradePrice is number && d.upgradePrice >= 0
        && d.quantity is int && d.quantity > 0
        && d.createdAt is number && d.createdAt >= 0 && d.updatedAt is number && d.updatedAt >= 0
        && optionalString(d, 'memberLabel', 200);
    }
    match /tickets/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && (tombstone(id) || validTicket(id));
    }
    match /items/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && (tombstone(id) || validItem(id));
    }
    match /cloudControl/counter {
      allow read: if isStaff();
      allow write: if isStaff() && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value is int && request.resource.data.value >= 0;
    }
    match /publicQueue/{id} {
      allow read: if true;
      allow delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['id', 'ticketNumber', 'status', 'position', 'seq', 'createdAt', 'calledAt', 'startedAt', 'updatedAt'])
        && request.resource.data.id == id
        && request.resource.data.ticketNumber is int && request.resource.data.ticketNumber > 0
        && request.resource.data.status in ['waiting', 'called', 'in_progress']
        && (request.resource.data.position == null || request.resource.data.position is int)
        && request.resource.data.seq is int
        && request.resource.data.createdAt is number && request.resource.data.updatedAt is number
        && (request.resource.data.calledAt == null || request.resource.data.calledAt is number)
        && (request.resource.data.startedAt == null || request.resource.data.startedAt is number);
    }
    match /public/public {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['key', 'eventActive', 'updatedAt', 'eventDate', 'eventLocation', 'eventMapUrl', 'eventTitle', 'eventHours', 'studioName', 'studioAddress', 'studioMapUrl', 'bookingEnabled', 'bookingDays', 'bookingSlots', 'blockedDates', 'bookingNoticeDays'])
        && request.resource.data.key == 'public' && request.resource.data.eventActive is bool
        && request.resource.data.updatedAt is number
        && optionalString(request.resource.data, 'eventDate', 2000)
        && optionalString(request.resource.data, 'eventLocation', 2000)
        && optionalString(request.resource.data, 'eventMapUrl', 2000)
        && optionalString(request.resource.data, 'eventTitle', 2000)
        && optionalString(request.resource.data, 'eventHours', 2000)
        && optionalString(request.resource.data, 'studioName', 2000)
        && optionalString(request.resource.data, 'studioAddress', 2000)
        && optionalString(request.resource.data, 'studioMapUrl', 2000)
        && (!('bookingEnabled' in request.resource.data) || request.resource.data.bookingEnabled is bool)
        && (!('bookingDays' in request.resource.data) || request.resource.data.bookingDays is list)
        && (!('bookingSlots' in request.resource.data) || request.resource.data.bookingSlots is list)
        && (!('blockedDates' in request.resource.data) || request.resource.data.blockedDates is list)
        && (!('bookingNoticeDays' in request.resource.data) || (request.resource.data.bookingNoticeDays is int && request.resource.data.bookingNoticeDays >= 0));
    }
    match /public/heartbeat {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['publishedAt'])
        && request.resource.data.publishedAt == request.time;
    }
    match /appointments/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'contact', 'date', 'time', 'notes', 'status', 'createdAt', 'requestedFor'])
        && request.resource.data.name is string && request.resource.data.name.matches('.*[^\\s].*') && request.resource.data.name.size() <= 60
        && request.resource.data.contact is string && request.resource.data.contact.matches('.*[^\\s].*') && request.resource.data.contact.size() <= 80
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.time is string && request.resource.data.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && request.resource.data.requestedFor is int && request.resource.data.requestedFor > request.time.toMillis()
        && request.resource.data.requestedFor < request.time.toMillis() + 31622400000
        && appointmentInstantMatches(request.resource.data)
        && optionalString(request.resource.data, 'notes', 300)
        && request.resource.data.status == 'requested' && request.resource.data.createdAt == request.time;
      allow read, delete: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['requested', 'confirmed', 'cancelled']
        && request.resource.data.updatedAt == request.time;
    }
  }
}
