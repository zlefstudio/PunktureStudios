{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "redirects": [
      { "source": "/", "destination": "/live.html", "type": 301 },
      { "source": "/index.html", "destination": "/live.html", "type": 301 }
    ]
  }
}
