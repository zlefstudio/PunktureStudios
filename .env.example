# Public Worker URL only. Never put payment/email secrets in VITE_ variables.
VITE_BOOKING_API_URL=https://punkture-booking.YOUR-SUBDOMAIN.workers.dev
# Verified public media host. Set explicitly empty for self-contained Firebase media.
# With no variable set, production builds default to this same verified host.
VITE_MEDIA_BASE_URL=https://punkture-media.zlef-dev.workers.dev
